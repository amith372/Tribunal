{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // The repo root, not `src`. This config only ever typechecks (`--noEmit`), and one
    // test deliberately reads `web/src/preflight-mirror.ts` to prove the browser's copy of
    // the pre-flight rules still agrees with this server's. `tsconfig.build.json` narrows
    // this back to `src` for the emit, where it decides the shape of `dist/`.
    "rootDir": "..",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    // The same alias `web/vite.config.ts` and `web/tsconfig.json` carry. This config's
    // `rootDir` is the repo root because `preflight-mirror.test.ts` reads the browser's
    // copy of the pre-flight rules — and that file now reaches back here through
    // `@record`, so this program has to resolve it too. Never reached by the emit:
    // `tsconfig.build.json` excludes the tests that pull `web/` in at all.
    "paths": { "@record/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts"]
}
